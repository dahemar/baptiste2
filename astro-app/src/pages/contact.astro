---
export const prerender = false;
import { loadContactData } from '../utils/sectionContentManager';

let contact = { email: '', instagram: '' };
try {
  contact = await loadContactData();
} catch {
  contact = { email: '', instagram: '' };
}

const email = String(contact?.email || '').trim();
const instagramRaw = String(contact?.instagram || '').trim();
let instagramHandle = '';
if (instagramRaw) {
  const raw = instagramRaw.trim();
  try {
    let maybeUrl = raw;
    if (/^www\./i.test(maybeUrl)) maybeUrl = 'https://' + maybeUrl;
    if (/^https?:\/\//i.test(maybeUrl)) {
      const parsed = new URL(maybeUrl);
      if (parsed.hostname.toLowerCase().includes('instagram.com')) {
        const path = parsed.pathname.replace(/\/+$/,'');
        const segs = path.split('/').filter(Boolean);
        instagramHandle = (segs.pop() || '').replace(/^@+/, '');
      }
    }
  } catch (e) {
    instagramHandle = '';
  }
  if (!instagramHandle) {
    instagramHandle = raw.replace(/^@+/, '').replace(/\/+$/,'').split(/[\/?#]/)[0];
  }
  instagramHandle = String(instagramHandle || '').trim();
}
const instagramUrl = instagramHandle ? `https://instagram.com/${encodeURIComponent(instagramHandle)}` : '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baptiste Le Chapelain</title>
  <link rel="stylesheet" href="/theatre-works.css">
  <style>
    .contact-page {
      padding: 2rem;
      max-width: 800px;
      margin: 0 auto;
      min-height: 100vh;
      padding-top: calc(var(--nav-height) + 2rem);
    }
    
    .contact-page p {
      font-size: 1rem;
      line-height: 1.6;
      color: #ffffff;
    }

    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .contact-link {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 2px;
      opacity: 0.9;
    }

    .contact-link:hover {
      opacity: 1;
    }
  </style>
</head>
<body>
  <nav class="main-nav">
    <div class="nav-container">
      <div class="nav-links">
        <a href="/" class="nav-link home-link" aria-label="theatre"><span class="desktop-label">music for theatre</span><span class="mobile-label">theatre</span></a>
        <a href="/music" class="nav-link">music</a>
        <a href="/audiovisual" class="nav-link">audiovisual</a>
        <a href="/contact" class="nav-link active">contact</a>
      </div>
    </div>
  </nav>

  <div class="contact-page">
    <div class="contact-links">
      {email ? (
        <a class="contact-link" href={`mailto:${email}`}>{email}</a>
      ) : (
        <p>Email not set yet.</p>
      )}

      {instagramUrl ? (
        <a class="contact-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
          @{instagramHandle}
        </a>
      ) : (
        <p>Instagram not set yet.</p>
      )}
    </div>
  </div>
</body>
</html>
