---
export const prerender = false;

export const headers = {
  'Cache-Control': 'public, max-age=0, s-maxage=120, stale-while-revalidate=600',
};

import '../styles/music.css';
import { loadMusicPageModel } from '../utils/musicPageData';

const images = import.meta.glob('../assets/music/*.{jpg,jpeg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const localImages: Record<string, string> = {};
for (const [assetPath, src] of Object.entries(images)) {
  const key = assetPath.split('/').pop() || '';
  if (key) localImages[key] = typeof src === 'string' ? src : '';
}

let allReleasesUrl = 'https://www.discogs.com/fr/artist/5751087-Apulati-Bien?superFilter=Releases';
let projects = [];

try {
  const model = await loadMusicPageModel(localImages);
  allReleasesUrl = model.allReleasesUrl || allReleasesUrl;
  projects = model.projects;
} catch {
  projects = [];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baptiste Le Chapelain</title>
  <link rel="dns-prefetch" href="//pub-f04cf0f8494f457e889559aa0b6e57b7.r2.dev">
  <link rel="dns-prefetch" href="//sheets.googleapis.com">
  <link rel="dns-prefetch" href="//docs.google.com">
  <link rel="preconnect" href="https://pub-f04cf0f8494f457e889559aa0b6e57b7.r2.dev" crossorigin>
  <link rel="stylesheet" href="/theatre-works.css">
</head>
<body>
  <nav class="main-nav">
    <div class="nav-container">
        <div class="nav-links">
          <a href="/about" class="nav-link" data-astro-prefetch="load">about</a>
          <a href="/" class="nav-link home-link" aria-label="theatre" data-astro-prefetch="load"><span class="desktop-label">sound for theatre</span><span class="mobile-label">theatre</span></a>
          <a href="/music" class="nav-link active" data-astro-prefetch="load">music</a>
          <a href="/audiovisual" class="nav-link" data-astro-prefetch="load">audiovisual</a>
        </div>
    </div>
  </nav>

  <div class="music-page">
    <a
      class="music-discogs-link"
      href={allReleasesUrl}
      target="_blank"
      rel="noreferrer"
    >
      view all releases on discogs →
    </a>

    {projects.map((section) => (
      <div class="music-section" data-project={section.name}>
        <h2 class="section-title">{section.name}</h2>
        <div class="music-grid">
          {section.releases.map((item) => (
            <a
              key={item.key}
              class="music-card"
              href={item.url}
              target="_blank"
              rel="noreferrer"
              title={item.title}
            >
              <div class="music-cover">
                {item.src ? (
                  <img src={item.src} alt={item.title} loading="lazy" decoding="async" onerror="this.remove()" />
                ) : null}
                <div class={`music-cover-placeholder${item.src ? '' : ' is-visible'}`}>{item.title.charAt(0)}</div>
              </div>
              <div class="music-meta">
                <div class="music-name">{item.title}</div>
                {item.format && <div class="music-format">{item.format}</div>}
                {item.year && <div class="music-year">{item.year}</div>}
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="music-section music-video-section">
      <h2 class="section-title">videos</h2>
      <div class="music-video-player">
        <iframe
          src="https://www.youtube.com/embed/videoseries?list=PL5hKVoM0x4JpIa3b9__0VqyjnROCsSTIc"
          title="video clips playlist"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</body>
</html>
