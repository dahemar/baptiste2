---
export const prerender = false;
import '../styles/audiovisual.css';
import { loadAudiovisualData } from '../utils/sectionContentManager';

let items = [];
try {
  items = await loadAudiovisualData();
} catch {
  items = [];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baptiste Le Chapelain</title>
  <link rel="stylesheet" href="/theatre-works.css">
</head>
<body>
  <nav class="main-nav">
    <div class="nav-container">
      <div class="nav-links">
        <a href="/" class="nav-link home-link" aria-label="theatre"><span class="desktop-label">music for theatre</span><span class="mobile-label">theatre</span></a>
        <a href="/music" class="nav-link">music</a>
        <a href="/audiovisual" class="nav-link active">audiovisual</a>
        <a href="/contact" class="nav-link">contact</a>
      </div>
    </div>
  </nav>

  <div class="av-page">
    <div class="av-list">
      {items.map(item => (
        <div key={item.id} class="av-item">
          <div class="av-media">
            {item.videoUrl ? (
              <video
                class="av-video"
                src={item.videoUrl}
                poster={item.thumbnailUrl || undefined}
                controls
                preload="metadata"
                playsinline
                crossorigin={item.videoUrl.includes('.r2.dev') ? 'anonymous' : undefined}
              />
            ) : item.thumbnailUrl ? (
              <img class="av-image" src={item.thumbnailUrl} alt={item.title} loading="lazy" />
            ) : (
              <div class="av-placeholder" aria-label="placeholder" />
            )}
          </div>
          <div class="av-meta">
            <div class="av-name">{item.title}</div>
            {item.credits && <div class="av-credits">{item.credits}</div>}
            <div class="av-year">{item.year}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</body>
</html>
