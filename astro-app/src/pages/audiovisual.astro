---
export const prerender = false;
import '../styles/audiovisual.css';
import { loadAudiovisualData } from '../utils/sectionContentManager';

let projects = [];
try {
  projects = await loadAudiovisualData();
} catch {
  projects = [];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baptiste Le Chapelain</title>
  <link rel="dns-prefetch" href="//pub-f04cf0f8494f457e889559aa0b6e57b7.r2.dev">
  <link rel="preconnect" href="https://pub-f04cf0f8494f457e889559aa0b6e57b7.r2.dev" crossorigin>
  <link rel="stylesheet" href="/theatre-works.css">
  <style>
    @media (max-width: 768px) {
      .av-media, .av-media img, .av-media video {
        border-radius: 0 !important;
        overflow: hidden !important;
      }
    }
  </style>
</head>
<body>
  <nav class="main-nav">
    <div class="nav-container">
      <div class="nav-links">
        <a href="/" class="nav-link home-link" aria-label="theatre"><span class="desktop-label">sound for theatre</span><span class="mobile-label">theatre</span></a>
        <a href="/music" class="nav-link">music</a>
        <a href="/audiovisual" class="nav-link active">audiovisual</a>
        <a href="/contact" class="nav-link">contact</a>
      </div>
    </div>
  </nav>

  <div class="av-page">
    <div class="av-list">
      {projects.map((project, projectIdx) => {
        const footerName = String(project?.footerName || '').trim();
        const footerCredits = String(project?.footerCredits || '').trim();
        const footerYear = String(project?.footerYear || '').trim();
        const hasFooter = !!(footerName || footerCredits || footerYear);

        return (
          <div class="av-project-group" data-project={project.projectTitle || undefined}>
            {projectIdx > 0 && <div class="av-divider" aria-hidden="true" />}

            {project.projectTitle && (
              <div class="av-project-title">{project.projectTitle}</div>
            )}

            {project.videos.map((video, videoIdx) => {
              const posterUrl = video.thumbnailUrl || undefined;
              const hasPoster = !!posterUrl;
              const eagerPoster = projectIdx < 2 && videoIdx < 2;

              return (
              <div key={video.id} class="av-item">
                <div class={`av-media${hasPoster ? ' av-has-poster' : ''}`}>
                  {hasPoster && (
                    <img
                      class="av-image"
                      src={posterUrl}
                      alt=""
                      loading={eagerPoster ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority={eagerPoster ? 'high' : 'auto'}
                    />
                  )}

                  {video.videoUrl ? (
                    <video
                      class="av-video"
                      src={video.videoUrl}
                      poster={posterUrl}
                      controls
                      preload={hasPoster ? 'none' : 'metadata'}
                      playsinline
                      webkit-playsinline
                    />
                  ) : !hasPoster ? (
                    <div class="av-placeholder" aria-label="placeholder" />
                  ) : null}
                </div>

                {(() => {
                  const title = String(video?.title || '').trim();
                  const credits = String(video?.credits || '').trim();
                  const year = String(video?.year || '').trim();

                  const sameAsFooter =
                    !!(footerName || footerCredits || footerYear) &&
                    title === footerName &&
                    credits === footerCredits &&
                    year === footerYear;

                  const showTitle = !!title;
                  const showCredits = !!credits;
                  const showYear = !!year;
                  const showAny = (showTitle || showCredits || showYear) && !sameAsFooter;

                  if (!showAny) return null;

                  return (
                    <div class="av-meta">
                      {showTitle && <div class="av-name">{title}</div>}
                      {showCredits && <div class="av-credits">{credits}</div>}
                      {showYear && <div class="av-year">{year}</div>}
                    </div>
                  );
                })()}
              </div>
            );
            })}

            {hasFooter && (
              <div class="av-meta av-group-meta">
                {footerName && <div class="av-name">{footerName}</div>}
                {footerCredits && <div class="av-credits">{footerCredits}</div>}
                {footerYear && <div class="av-year">{footerYear}</div>}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</body>
</html>

<script>
  // Small client-side helper: make thumbnail <img> start the sibling <video> on click
  // and hide the image while the video is playing. Works for mobile Safari where
  // video.poster can sometimes not render reliably.
  (function () {
    try {
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.av-media').forEach(function (container) {
          var video = container.querySelector('video');
          var img = container.querySelector('img.av-image');
          if (!video) return;

          var showPoster = function () {
            container.classList.remove('av-playing');
            if (img) img.style.display = '';
          };
          var showVideo = function () {
            container.classList.add('av-playing');
            if (img) img.style.display = 'none';
          };

          showPoster();

          if (img) {
            img.addEventListener('click', function (e) {
              e.preventDefault();
              video.play().catch(function () {});
            });
          }

          video.addEventListener('play', showVideo);
          video.addEventListener('pause', function () {
            if (video.currentTime === 0 || video.ended) showPoster();
          });
          video.addEventListener('ended', showPoster);
        });
      });
    } catch (e) {
      // noop
    }
  })();
</script>
